    function formatHours(hrs) {
      const h = Math.floor(hrs);
      const m = Math.round((hrs - h) * 60);
      return `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m`;
    }

    // Switch Month and smoothly re-render everything
    function switchMonth(monthKey) {
      activeMonthKey = monthKey;
      const data = monthlyDataStore[monthKey];
      if (!data) return;

      // Update Breadcrumb & Header
      document.getElementById('breadcrumbPeriod').innerText = data.periodLabel;
      document.getElementById('tableFilterTag').innerText = `${data.periodLabel} Fleet`;
      document.getElementById('mergedRowsLabel').innerText = `Merged BASE + BASE2: ${data.barges.length} Barges`;

