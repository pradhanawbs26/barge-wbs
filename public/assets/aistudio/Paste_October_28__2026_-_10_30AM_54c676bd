<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Port Operations & Coal Loading Management System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js CDN for charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    :root {
      --font-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", sans-serif;
    }

    body {
      font-family: var(--font-apple);
      background-color: #F5F5F7;
      color: #1D1D1F;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
    }

    /* Apple-grade glassmorphism */
    .cupertino-glass {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(25px) saturate(180%);
      -webkit-backdrop-filter: blur(25px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .sidebar-glass {
      background: rgba(246, 246, 248, 0.82);
      backdrop-filter: blur(30px) saturate(190%);
      -webkit-backdrop-filter: blur(30px) saturate(190%);
      border-right: 1px solid rgba(0, 0, 0, 0.06);
    }

    /* Apple continuous rounded squircle shadow */
    .apple-card {
      background: #FFFFFF;
      border-radius: 20px;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      border: 1px solid rgba(0, 0, 0, 0.03);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .apple-card:hover {
      box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.06), 0 4px 10px -2px rgba(0, 0, 0, 0.03);
    }

    /* Custom smooth scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.15);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 0, 0, 0.25);
    }

    /* Status badge styles according to Apple System Colors */
    .badge-system-green {
      background-color: rgba(52, 199, 89, 0.12);
      color: #248A3D;
      border: 1px solid rgba(52, 199, 89, 0.25);
    }
    .badge-system-red {
      background-color: rgba(255, 59, 48, 0.12);
      color: #D70015;
      border: 1px solid rgba(255, 59, 48, 0.25);
    }
    .badge-system-amber {
      background-color: rgba(255, 149, 0, 0.12);
      color: #C97000;
      border: 1px solid rgba(255, 149, 0, 0.25);
    }
    .badge-system-blue {
      background-color: rgba(0, 122, 255, 0.12);
      color: #0062CC;
      border: 1px solid rgba(0, 122, 255, 0.22);
    }

    /* Speedometer SVG stroke transitions */
    .gauge-needle {
      transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-origin: 100px 95px;
    }
  </style>
</head>
<body class="h-screen w-screen flex overflow-hidden select-none">

  <!-- ==================== GLOBAL SIDEBAR (Frosted Glass) ==================== -->
  <aside class="sidebar-glass w-72 flex-shrink-0 flex flex-col justify-between p-5 z-20">
    <div>
      <!-- Brand & Header -->
      <div class="flex items-center space-x-3 px-2 py-3 mb-6">
        <div class="w-10 h-10 rounded-2xl bg-[#007AFF] flex items-center justify-center text-white shadow-md shadow-blue-500/20">
          <i data-lucide="anchor" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="text-[15px] font-semibold text-[#1D1D1F] tracking-tight leading-tight">PortFlow OS</h1>
          <p class="text-[11px] font-medium text-[#86868B] tracking-tight">Coal Loading Operations</p>
        </div>
      </div>

      <!-- CRITICAL GLOBAL MONTH FILTER -->
      <div class="mb-6 px-2">
        <label class="block text-[11px] font-semibold tracking-wider text-[#86868B] uppercase mb-2">
          Operations Period
        </label>
        <div class="relative">
          <select id="globalMonthSelect" onchange="switchMonth(this.value)" 
                  class="w-full appearance-none bg-white/90 border border-black/[0.08] text-[#1D1D1F] font-semibold text-[13px] rounded-xl px-3.5 py-2.5 pr-8 focus:outline-none focus:ring-2 focus:ring-[#007AFF]/30 focus:border-[#007AFF] shadow-sm cursor-pointer transition-all">
            <option value="2026-10" selected>October 2026 (Active)</option>
            <option value="2026-09">September 2026</option>
            <option value="2026-08">August 2026</option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#86868B]">
            <i data-lucide="chevron-down" class="w-4 h-4"></i>
          </div>
        </div>
        <p class="text-[10px] text-[#86868B] mt-1.5 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#34C759] inline-block animate-pulse"></span>
          Auto-synced with BASE & BASE2 logs
        </p>
      </div>

      <!-- Navigation links -->
      <nav class="space-y-1">
        <div class="text-[10px] font-semibold tracking-wider text-[#86868B] uppercase px-3 py-1">Main Views</div>
        <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl bg-black/[0.05] text-[#007AFF] font-medium text-[13px] transition-colors">
          <i data-lucide="layout-dashboard" class="w-4 h-4 text-[#007AFF]"></i>
          <span>Coal Loading Overview</span>
        </a>
        <a href="#ganttSection" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-[#48484A] hover:bg-black/[0.03] font-medium text-[13px] transition-colors">
          <i data-lucide="calendar-range" class="w-4 h-4 text-[#86868B]"></i>
          <span>Berth & Gantt Timeline</span>
        </a>
        <a href="#productivitySection" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-[#48484A] hover:bg-black/[0.03] font-medium text-[13px] transition-colors">
          <i data-lucide="gauge" class="w-4 h-4 text-[#86868B]"></i>
          <span>BLC & Delay Analytics</span>
        </a>
        <a href="#bargeTableSection" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-[#48484A] hover:bg-black/[0.03] font-medium text-[13px] transition-colors">
          <i data-lucide="ship" class="w-4 h-4 text-[#86868B]"></i>
          <span>Barge Manifest Registry</span>
        </a>
      </nav>

      <div class="mt-8 px-2">
        <div class="text-[10px] font-semibold tracking-wider text-[#86868B] uppercase px-1 mb-2">Live Terminal Status</div>
        <div class="p-3 bg-white/70 rounded-2xl border border-black/[0.04] space-y-2 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-[#86868B]">Conveyor Line 01</span>
            <span class="text-[#34C759] font-medium flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Operational</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-[#86868B]">Chute / Shiploader</span>
            <span class="text-[#34C759] font-medium flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span> Active (BLC-2)</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-[#86868B]">Weather Condition</span>
            <span class="text-[#007AFF] font-medium flex items-center gap-1"><i data-lucide="sun" class="w-3 h-3"></i> Clear (29°C)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom User Profile / Machine ID -->
    <div class="pt-4 border-t border-black/[0.05] px-2 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-gray-200 to-gray-400 flex items-center justify-center text-xs font-semibold text-gray-700">
          OC
        </div>
        <div>
          <div class="text-[12px] font-semibold text-[#1D1D1F]">Capt. Henderson</div>
          <div class="text-[10px] text-[#86868B]">Terminal Superintendent</div>
        </div>
      </div>
      <button class="text-[#86868B] hover:text-[#1D1D1F] transition-colors p-1" title="Settings">
        <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
      </button>
    </div>
  </aside>

  <!-- ==================== MAIN CONTENT AREA ==================== -->
  <main class="flex-1 overflow-y-auto px-8 py-7 space-y-7">
    
    <!-- Top Bar: Title & Apple Quick Action Controls -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-1">
      <div>
        <div class="flex items-center gap-2 text-xs text-[#86868B] font-medium">
          <span>Terminal Hub</span>
          <i data-lucide="chevron-right" class="w-3 h-3"></i>
          <span>Jetty 03 (Coal Terminal)</span>
          <i data-lucide="chevron-right" class="w-3 h-3"></i>
          <span class="text-[#1D1D1F]" id="breadcrumbPeriod">October 2026</span>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-[#1D1D1F] mt-1">
          Port Operations & Coal Loading Dashboard
        </h2>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-3 py-1.5 rounded-full text-xs font-medium cupertino-glass text-[#48484A] flex items-center gap-1.5 shadow-sm">
          <i data-lucide="database" class="w-3.5 h-3.5 text-[#007AFF]"></i>
          <span id="mergedRowsLabel">Merged BASE + BASE2: 8 Barges</span>
        </span>
        <button onclick="exportReport()" class="px-4 py-2 rounded-xl bg-[#007AFF] text-white text-xs font-semibold shadow-md shadow-blue-500/20 hover:bg-[#0071E3] active:scale-[0.98] transition-all flex items-center gap-1.5">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>Export Summary</span>
        </button>
      </div>
    </header>

    <!-- ==================== ROW 1: EXECUTIVE KPIs ==================== -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- KPI 1: Total Volume -->
      <div class="apple-card p-5 relative overflow-hidden">
        <div class="flex items-center justify-between text-[#86868B] mb-2">
          <span class="text-xs font-medium tracking-tight">Total Volume (MT)</span>
          <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center text-[#007AFF]">
            <i data-lucide="layers" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold tracking-tight text-[#1D1D1F]" id="kpiTotalVolume">64,250</span>
          <span class="text-xs font-semibold text-[#86868B]">MT</span>
        </div>
        <div class="mt-3 flex items-center text-xs text-[#34C759] font-medium">
          <i data-lucide="trending-up" class="w-3.5 h-3.5 mr-1"></i>
          <span>+6.4% vs prev. cycle</span>
        </div>
      </div>

      <!-- KPI 2: Avg Loading Rate -->
      <div class="apple-card p-5 relative overflow-hidden">
        <div class="flex items-center justify-between text-[#86868B] mb-2">
          <span class="text-xs font-medium tracking-tight">Avg Loading Rate</span>
          <div class="w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center text-[#34C759]">
            <i data-lucide="zap" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold tracking-tight text-[#1D1D1F]" id="kpiLoadingRate">1,392</span>
          <span class="text-xs font-semibold text-[#86868B]">Ton / Hour</span>
        </div>
        <div class="mt-3 flex items-center text-xs text-[#34C759] font-medium">
          <i data-lucide="check-circle" class="w-3.5 h-3.5 mr-1"></i>
          <span>+42 Ton/h above 1350 goal</span>
        </div>
      </div>

      <!-- KPI 3: Avg Idle Time -->
      <div class="apple-card p-5 relative overflow-hidden">
        <div class="flex items-center justify-between text-[#86868B] mb-2">
          <span class="text-xs font-medium tracking-tight">Avg Idle Time</span>
          <div class="w-7 h-7 rounded-full bg-amber-50 flex items-center justify-center text-[#FF9500]">
            <i data-lucide="clock" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold tracking-tight text-[#1D1D1F]" id="kpiIdleTime">48</span>
          <span class="text-xs font-semibold text-[#86868B]">Minutes / Barge</span>
        </div>
        <div class="mt-3 flex items-center text-xs text-[#34C759] font-medium">
          <i data-lucide="arrow-down-right" class="w-3.5 h-3.5 mr-1"></i>
          <span>-12 min mooring turn-time</span>
        </div>
      </div>

      <!-- KPI 4: BLC Productivity vs Target -->
      <div class="apple-card p-5 relative overflow-hidden">
        <div class="flex items-center justify-between text-[#86868B] mb-2">
          <span class="text-xs font-medium tracking-tight">BLC Productivity</span>
          <div class="w-7 h-7 rounded-full bg-purple-50 flex items-center justify-center text-purple-600">
            <i data-lucide="activity" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold tracking-tight text-[#1D1D1F]" id="kpiProductivity">103.1%</span>
          <span class="text-xs font-semibold text-[#86868B]">vs 1,350 Target</span>
        </div>
        <div class="mt-3 flex items-center text-xs font-medium text-[#248A3D] flex gap-1">
          <span class="px-2 py-0.5 rounded-md badge-system-green text-[10px] font-semibold">Sesuai Target</span>
          <span class="text-[#86868B]">Overall Status</span>
        </div>
      </div>
    </section>

    <!-- ==================== ROW 2: TIMELINE (Operational Gantt Chart) ==================== -->
    <section id="ganttSection" class="apple-card p-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-5 gap-3">
        <div>
          <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight flex items-center gap-2">
            <span>Operational Gantt Chart — Jetty Conveyor Berth 1</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] bg-black/[0.05] text-[#86868B] font-medium">Time Horizon: 48h Shift Window</span>
          </h3>
          <p class="text-xs text-[#86868B] mt-0.5">
            X-axis represents continuous timeline. Visualizing active loading runs, operational delays, and idle mooring buffer gaps.
          </p>
        </div>

        <!-- Legend -->
        <div class="flex items-center gap-4 text-xs font-medium">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-[#007AFF]"></span>
            <span class="text-[#48484A]">Coal Loading</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-[#FF3B30]"></span>
            <span class="text-[#48484A]">Controllable Delay</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-[#FF9500]"></span>
            <span class="text-[#48484A]">Weather / Rain Delay</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-gray-200 border border-dashed border-gray-400"></span>
            <span class="text-[#86868B]">Idle Turnaround</span>
          </div>
        </div>
      </div>

      <!-- Gantt Interactive Container -->
      <div class="relative overflow-x-auto border border-black/[0.06] rounded-2xl bg-[#FAFAFC] p-4">
        
        <!-- Timeline Header Markers (00:00 to 44:00 hours) -->
        <div class="grid grid-cols-12 gap-1 pb-2 border-b border-black/[0.06] text-[10px] text-[#86868B] font-semibold text-center pl-44">
          <div>Day 1 00:00</div>
          <div>04:00</div>
          <div>08:00</div>
          <div>12:00</div>
          <div>16:00</div>
          <div>20:00</div>
          <div>Day 2 00:00</div>
          <div>04:00</div>
          <div>08:00</div>
          <div>12:00</div>
          <div>16:00</div>
          <div>20:00</div>
        </div>

        <!-- Barges Rows -->
        <div id="ganttRowsContainer" class="space-y-3 pt-3">
          <!-- Populated by JavaScript according to chosen month -->
        </div>
      </div>
      
      <div class="flex items-center justify-between text-xs text-[#86868B] mt-3 px-1">
        <span class="flex items-center gap-1">
          <i data-lucide="info" class="w-3.5 h-3.5 text-[#007AFF]"></i>
          Hover on bar segments to inspect detailed coal tonnage, delay causation, and duration.
        </span>
        <span>Average Berth Occupancy Rate: <strong class="text-[#1D1D1F]">88.4%</strong></span>
      </div>
    </section>

    <!-- ==================== ROW 3: SPLIT VIEW (Speedometer Gauge + Pareto Delay Chart) ==================== -->
    <section id="productivitySection" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- LEFT: Speedometer Gauge Chart (BLC Productivity) -->
      <div class="lg:col-span-5 apple-card p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">BLC Productivity Speedometer</h3>
              <p class="text-xs text-[#86868B] mt-0.5">Bucket Loader & Conveyor throughput against rated capacity</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold badge-system-green" id="gaugeStatusBadge">
              Sesuai Target
            </span>
          </div>
          
          <div class="mt-4 flex flex-col items-center justify-center">
            <!-- Custom Apple-styled SVG Speedometer Gauge -->
            <div class="relative w-72 h-44 flex items-center justify-center">
              <svg viewBox="0 0 200 120" class="w-full h-full overflow-visible">
                <defs>
                  <!-- Red Zone Gradient -->
                  <linearGradient id="redZoneGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#FF3B30" />
                    <stop offset="100%" stop-color="#FF9500" />
                  </linearGradient>
                  <!-- Green Zone Gradient -->
                  <linearGradient id="greenZoneGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#34C759" />
                    <stop offset="100%" stop-color="#30D158" />
                  </linearGradient>
                  <filter id="needleGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.25"/>
                  </filter>
                </defs>

                <!-- Background Track (Gray) -->
                <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#E5E5EA" stroke-width="16" stroke-linecap="round" />

                <!-- Red/Under-target Arc (0 to 1350 Ton/h, which is 65% of 2000 scale) -->
                <!-- Angle span 180 deg: from -180 deg to 0 deg -->
                <!-- Red Arc (0 to ~1350) -->
                <path d="M 20 100 A 80 80 0 0 1 140 32" fill="none" stroke="url(#redZoneGrad)" stroke-width="16" stroke-linecap="round" />

                <!-- Green/Optimal Arc (1350 to 2000 Ton/h) -->
                <path d="M 140 32 A 80 80 0 0 1 180 100" fill="none" stroke="url(#greenZoneGrad)" stroke-width="16" stroke-linecap="round" />

                <!-- Target Milestone Indicator (1,350 T/H) -->
                <line x1="140" y1="32" x2="148" y2="24" stroke="#1D1D1F" stroke-width="2.5" stroke-linecap="round"/>
                <text x="135" y="15" font-size="7" font-weight="700" fill="#1D1D1F" text-anchor="middle">TARGET 1,350</text>

                <!-- Tick labels -->
                <text x="18" y="114" font-size="7" fill="#86868B" font-weight="600">0</text>
                <text x="50" y="55" font-size="7" fill="#86868B" font-weight="500">600</text>
                <text x="100" y="32" font-size="7" fill="#86868B" font-weight="500">1000</text>
                <text x="182" y="114" font-size="7" fill="#86868B" font-weight="600">2000</text>

                <!-- Needle -->
                <!-- Default rotates from 0deg (pointing left = 0 T/H) to 180deg (pointing right = 2000 T/H) -->
                <g id="speedoNeedleGroup" class="gauge-needle" style="transform: rotate(125deg); transform-origin: 100px 95px;">
                  <polygon points="98,95 102,95 100.8,25 99.2,25" fill="#1D1D1F" filter="url(#needleGlow)" />
                  <circle cx="100" cy="95" r="7" fill="#1D1D1F" />
                  <circle cx="100" cy="95" r="3" fill="#FFFFFF" />
                </g>
              </svg>

              <!-- Digital Value Inset -->
              <div class="absolute bottom-1 text-center">
                <div class="text-3xl font-extrabold tracking-tight text-[#1D1D1F]" id="gaugeCurrentVal">1,392</div>
                <div class="text-[11px] font-semibold text-[#86868B]">Ton / Hour Achieved</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Gauge Summary Metrics Footnote -->
        <div class="mt-4 pt-4 border-t border-black/[0.05] grid grid-cols-2 gap-3 text-center">
          <div class="bg-gray-50/80 rounded-xl p-2.5">
            <span class="text-[10px] text-[#86868B] block font-medium">Standard Rated Goal</span>
            <span class="text-sm font-bold text-[#1D1D1F]">1,350 T/H</span>
          </div>
          <div class="bg-gray-50/80 rounded-xl p-2.5">
            <span class="text-[10px] text-[#86868B] block font-medium">Variance (Delta)</span>
            <span class="text-sm font-bold text-[#248A3D]" id="gaugeVariance">+42.0 T/H (+3.1%)</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: Pareto Bar Chart (Delay Breakdown) -->
      <div class="lg:col-span-7 apple-card p-6 flex flex-col justify-between">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">Pareto Delay Breakdown</h3>
            <p class="text-xs text-[#86868B] mt-0.5">Highest-to-lowest root causes categorized by Controllable vs Uncontrollable</p>
          </div>
          <!-- Legend Badges -->
          <div class="flex items-center gap-2">
