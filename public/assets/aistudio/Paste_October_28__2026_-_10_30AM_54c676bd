        statusBadge.className = "px-2.5 py-1 rounded-full text-xs font-semibold badge-system-red";
        statusBadge.innerText = "Under Target";
        document.getElementById('gaugeVariance').className = "text-sm font-bold text-[#D70015]";
      }

      // 3. Render Gantt Chart
      renderGanttChart(data.barges);

      // 4. Render Pareto Chart
      renderParetoChart(data.delays);

      // 5. Render Table
      renderTable(data.barges);
    }

    // Render Gantt Timeline
    function renderGanttChart(barges) {
      const container = document.getElementById('ganttRowsContainer');
      container.innerHTML = '';

      // Total timeline horizon represents 48 hours for scaling percentage (100% = 48h)
      const totalHorizonHours = 48;

      barges.forEach((b, index) => {
        const row = document.createElement('div');
        row.className = "flex items-center text-xs group py-1.5 hover:bg-black/[0.02] rounded-xl px-2 transition-colors";

        // Barge label column
        const labelCol = document.createElement('div');
        labelCol.className = "w-44 flex-shrink-0 pr-3";
        labelCol.innerHTML = `
          <div class="font-semibold text-[#1D1D1F] truncate">${b.name}</div>
          <div class="text-[10px] text-[#86868B] flex items-center gap-1.5">
            <span>${b.volume.toLocaleString()} MT</span>
            <span>•</span>
            <span class="${b.status === 'Sesuai Target' ? 'text-[#248A3D]' : 'text-[#D70015]'} font-medium">${b.status}</span>
          </div>
        `;

        // Bar track container
        const barTrack = document.createElement('div');
        barTrack.className = "flex-1 relative h-8 bg-gray-100/70 rounded-xl overflow-hidden border border-black/[0.04]";

        // Calculate positions in %
        // To fit into the 48h view, modulate startHour slightly
        const normalizedStart = (b.gantt.startHour % 40);
        const startPct = Math.min(Math.max((normalizedStart / totalHorizonHours) * 100, 0), 85);
        const loadPct = Math.min((b.gantt.loadDuration / totalHorizonHours) * 100, 35);
        const delayPct = Math.min((b.gantt.delayDuration / totalHorizonHours) * 100, 20);

        // Active Loading Bar (Blue)
        const loadBar = document.createElement('div');
        loadBar.className = "absolute top-1 bottom-1 bg-[#007AFF] text-white rounded-lg flex items-center px-2 text-[10px] font-medium shadow-sm transition-all hover:brightness-110 cursor-pointer overflow-hidden";
        loadBar.style.left = `${startPct}%`;
        loadBar.style.width = `${loadPct}%`;
        loadBar.title = `${b.name}: Coal Loading (${b.gantt.loadDuration}h) - ${b.loadingRate} T/H`;
        loadBar.innerHTML = `<span class="truncate">Loading ${b.gantt.loadDuration}h</span>`;

        barTrack.appendChild(loadBar);

        // Delay Bar (Red or Amber) if any
        if (b.gantt.delayDuration > 0) {
          const delayBar = document.createElement('div');
          const isControllable = b.gantt.delayType === 'controllable';
          delayBar.className = `absolute top-1 bottom-1 ${isControllable ? 'bg-[#FF3B30]' : 'bg-[#FF9500]'} text-white rounded-lg flex items-center px-2 text-[10px] font-medium shadow-sm transition-all hover:brightness-110 cursor-pointer overflow-hidden`;
          delayBar.style.left = `${startPct + loadPct + 0.3}%`;
          delayBar.style.width = `${Math.max(delayPct, 4)}%`;
          delayBar.title = `Delay: ${b.gantt.delayLabel} (${b.gantt.delayDuration}h)`;
          delayBar.innerHTML = `<span class="truncate">${b.gantt.delayLabel}</span>`;
          barTrack.appendChild(delayBar);
        }

        // Idle space representation (visual dotted indicator after load)
        const idleMark = document.createElement('div');
        idleMark.className = "absolute top-2 bottom-2 border-r-2 border-dashed border-gray-400/50";
        const idleLeft = startPct + loadPct + (b.gantt.delayDuration > 0 ? Math.max(delayPct, 4) : 0) + 0.5;
        idleMark.style.left = `${Math.min(idleLeft + 2.5, 98)}%`;
        idleMark.title = `Idle Gap: ${Math.round(b.gantt.idleGap * 60)} minutes`;
        barTrack.appendChild(idleMark);

        row.appendChild(labelCol);
        row.appendChild(barTrack);
        container.appendChild(row);
      });
    }

    // Render Pareto Delay Chart
    function renderParetoChart(delays) {
      const ctx = document.getElementById('paretoChartCanvas').getContext('2d');
      if (paretoChartInstance) {
        paretoChartInstance.destroy();
      }

      // Sort delays descending
      const sorted = [...delays].sort((a, b) => b.hours - a.hours);
      const labels = sorted.map(d => d.reason);
      const hours = sorted.map(d => d.hours);
      
      const totalHours = hours.reduce((acc, v) => acc + v, 0);
      let cumulativeSum = 0;
      const cumulativePercentages = hours.map(h => {
        cumulativeSum += h;
        return ((cumulativeSum / totalHours) * 100).toFixed(1);
      });

      // Update top 2 pct stat
      const top2Sum = hours[0] + hours[1];
      document.getElementById('topTwoDelayPct').innerText = `${((top2Sum / totalHours) * 100).toFixed(1)}%`;

      // Apple palette colors
      const backgroundColors = sorted.map(d => d.type === 'controllable' ? 'rgba(255, 59, 48, 0.85)' : 'rgba(255, 149, 0, 0.85)');

      paretoChartInstance = new Chart(ctx, {
        data: {
          labels: labels,
          datasets: [
            {
              type: 'line',
              label: 'Cumulative Impact %',
              data: cumulativePercentages,
              borderColor: '#007AFF',
              borderWidth: 2.5,
              pointBackgroundColor: '#FFFFFF',
              pointBorderColor: '#007AFF',
              pointBorderWidth: 2,
              pointRadius: 4,
              pointHoverRadius: 6,
              yAxisID: 'yCumulative',
              tension: 0.25,
              order: 1
            },
            {
              type: 'bar',
              label: 'Lost Operational Hours',
              data: hours,
              backgroundColor: backgroundColors,
              borderRadius: 8,
              borderSkipped: false,
              barThickness: 28,
              yAxisID: 'yHours',
              order: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              align: 'end',
              labels: {
                boxWidth: 10,
                boxHeight: 10,
                usePointStyle: true,
                pointStyle: 'circle',
                font: { family: '-apple-system, Inter, sans-serif', size: 11, weight: '500' },
                color: '#86868B'
              }
            },
            tooltip: {
              backgroundColor: 'rgba(29, 29, 31, 0.95)',
              padding: 12,
              cornerRadius: 12,
              titleFont: { size: 12, weight: '600' },
              bodyFont: { size: 11 },
              callbacks: {
                label: function(context) {
                  if (context.dataset.type === 'line') {
                    return ` Cumulative: ${context.parsed.y}% of total delays`;
                  }
                  return ` Duration: ${context.parsed.y} Hours lost`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: {
                color: '#86868B',
                font: { size: 10, weight: '500' },
                callback: function(val, index) {
                  const lbl = labels[index];
                  return lbl.length > 18 ? lbl.substring(0, 18) + '...' : lbl;
                }
              }
            },
            yHours: {
              type: 'linear',
              position: 'left',
              title: {
                display: true,
                text: 'Lost Hours',
                color: '#86868B',
                font: { size: 10, weight: '600' }
              },
              grid: { color: 'rgba(0, 0, 0, 0.04)' },
              ticks: { color: '#86868B', font: { size: 10 } }
            },
            yCumulative: {
              type: 'linear',
              position: 'right',
              min: 0,
              max: 100,
              title: {
                display: true,
                text: 'Cumulative %',
                color: '#86868B',
                font: { size: 10, weight: '600' }
              },
              grid: { display: false },
              ticks: {
                color: '#86868B',
                font: { size: 10 },
                callback: function(v) { return v + '%'; }
              }
            }
          }
        }
      });
    }

    // Render Minimalist Data Table
    function renderTable(barges) {
      const tbody = document.getElementById('bargeTableBody');
      tbody.innerHTML = '';

      barges.forEach((b) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-black/[0.015] transition-colors";

        const isGood = b.status === "Sesuai Target";
        const badgeClass = isGood ? "badge-system-green" : "badge-system-red";
        const iconName = isGood ? "check" : "alert-triangle";

        tr.innerHTML = `
          <td class="py-3 px-4 font-medium text-[#1D1D1F]">
            <div class="font-semibold text-[13px]">${b.name}</div>
            <div class="text-[11px] text-[#86868B]">${b.tug}</div>
          </td>
          <td class="py-3 px-4 text-[#48484A]">
            <span class="px-2 py-0.5 rounded-md bg-gray-100 text-[11px] font-medium text-gray-700">${b.spec}</span>
          </td>
          <td class="py-3 px-4 text-right font-semibold text-[#1D1D1F]">
            ${b.volume.toLocaleString()} <span class="text-[10px] text-[#86868B] font-normal">MT</span>
          </td>
          <td class="py-3 px-4 text-right text-[#48484A]">
            ${formatHours(b.targetHours)}
          </td>
          <td class="py-3 px-4 text-right font-medium ${isGood ? 'text-[#1D1D1F]' : 'text-[#D70015] font-semibold'}">
            ${formatHours(b.actualHours)}
          </td>
          <td class="py-3 px-4 text-right font-semibold ${b.loadingRate >= 1350 ? 'text-[#248A3D]' : 'text-[#D70015]'}">
            ${b.loadingRate.toLocaleString()} <span class="text-[10px] text-[#86868B] font-normal">T/H</span>
          </td>
          <td class="py-3 px-4 text-center">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${badgeClass}">
              <i data-lucide="${iconName}" class="w-3 h-3"></i>
              ${b.status}
            </span>
          </td>
          <td class="py-3 px-4 text-center">
            <button onclick="viewBargeDetail('${b.id}')" class="px-2.5 py-1 text-xs text-[#007AFF] hover:bg-blue-50 rounded-lg transition-colors font-medium">
              Inspect
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });

      document.getElementById('tableEntriesSummary').innerText = `Showing ${barges.length} of ${barges.length} barges logged for this operational window`;
      lucide.createIcons();
    }

    // Interactive filter for table search & status
    function filterTable() {
      const q = document.getElementById('bargeSearchInput').value.toLowerCase();
      const statusFilter = document.getElementById('statusFilter').value;
      const data = monthlyDataStore[activeMonthKey];

      const filtered = data.barges.filter(b => {
        const matchesQuery = b.name.toLowerCase().includes(q) || b.tug.toLowerCase().includes(q) || b.spec.toLowerCase().includes(q);
        const matchesStatus = statusFilter === 'ALL' || b.status === statusFilter;
        return matchesQuery && matchesStatus;
      });

      renderTable(filtered);
    }

    // Modal popup inspect
    function viewBargeDetail(bargeId) {
      const data = monthlyDataStore[activeMonthKey];
      const barge = data.barges.find(b => b.id === bargeId);
      if (!barge) return;

      document.getElementById('modalBargeName').innerText = barge.name;
      document.getElementById('modalTugName').innerText = `Tug Assistance: ${barge.tug}`;
      document.getElementById('modalVolume').innerText = `${barge.volume.toLocaleString()} MT`;
      document.getElementById('modalRate').innerText = `${barge.loadingRate.toLocaleString()} Ton / Hour`;
      document.getElementById('modalTarget').innerText = formatHours(barge.targetHours);
      document.getElementById('modalActual').innerText = formatHours(barge.actualHours);

      const auditEl = document.getElementById('modalAuditText');
      if (barge.status === "Sesuai Target") {
        auditEl.innerText = `BASE volume (${barge.volume} MT) matched load cell integration accurately. Conveyor maintained ${barge.loadingRate} T/H without exceeding thermal or mechanical envelope.`;
      } else {
        auditEl.innerText = `Delay registered: ${barge.gantt.delayLabel}. Actual duration overran target by ${(barge.actualHours - barge.targetHours).toFixed(2)} hours. Review equipment telemetry.`;
      }

      document.getElementById('bargeDetailModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeModal() {
      document.getElementById('bargeDetailModal').classList.add('hidden');
    }

    function exportReport() {
      const data = monthlyDataStore[activeMonthKey];
      alert(`Report generated for ${data.periodLabel}.\nTotal Volume: ${data.kpis.totalVolume} MT\nAverage BLC Rate: ${data.kpis.loadingRate} T/H\nStatus: ${data.kpis.blcProductivity} vs target.`);
    }

    function toggleParetoView() {
      alert("Opening Root Cause Corrective Action (CAPA) logs for coal handling systems...");
    }

    // Initialize on window load
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      switchMonth("2026-10");
    });
  </script>
</body>
