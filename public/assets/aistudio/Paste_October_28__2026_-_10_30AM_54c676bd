      document.getElementById('kpiTotalVolume').innerText = data.kpis.totalVolume;
      document.getElementById('kpiLoadingRate').innerText = data.kpis.loadingRate;
      document.getElementById('kpiIdleTime').innerText = data.kpis.idleTime;
      document.getElementById('kpiProductivity').innerText = data.kpis.blcProductivity;

      // 2. Update Speedometer Gauge
      document.getElementById('gaugeCurrentVal').innerText = data.kpis.loadingRate;
      document.getElementById('gaugeVariance').innerText = data.kpis.deltaText;
      
      const needle = document.getElementById('speedoNeedleGroup');
      needle.style.transform = `rotate(${data.speedoAngle}deg)`;

      const statusBadge = document.getElementById('gaugeStatusBadge');
      if (data.kpis.isTargetMet) {
        statusBadge.className = "px-2.5 py-1 rounded-full text-xs font-semibold badge-system-green";
